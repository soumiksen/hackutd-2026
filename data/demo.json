  "scenarios": [
    {
      "id": 1,
      "name": "Happy path, mockpark",
      "user_id": "demo-user-1",
      "vehicle_id": "veh_demo_1",
      "property_id": "utd-001",
      "url_params": {
        "property": "NSA481"
      },
      "expect": "confirmed"
    },
    {
      "id": 2,
      "name": "CAPTCHA hand-off",
      "user_id": "demo-user-1",
      "vehicle_id": "veh_demo_1",
      "property_id": "utd-001",
      "url_params": {
        "property": "NSA481",
        "captcha": "on"
      },
      "expect": "needs_user:captcha, then confirmed after resume",
      "note": "Run the backend with DEMO_PORTAL_PARAMS=captcha=on; resume drops it automatically."
    },
    {
      "id": 3,
      "name": "guestpass layout (Nemotron fallback)",
      "user_id": "demo-user-1",
      "vehicle_id": "veh_demo_1",
      "property_id": "utd-009",
      "url_params": {
        "property": "MHN734"
      },
      "expect": "confirmed"
    },
    {
      "id": 4,
      "name": "Guest-night limit",
      "user_id": "demo-user-1",
      "vehicle_id": "veh_demo_1",
      "property_id": "utd-002",
      "url_params": {
        "property": "NSP272"
      },
      "expect": "utd-002 allows 2 nights. Register plate ABC1234 there twice; the third draft is refused by the backend's guest-night check. To show the portal-side rule_conflict instead, register the same plate from demo-user-2: the portal counter (kept in proofs/.portal_state.json) hits the limit and the agent asks to override."
    },
    {
      "id": 5,
      "name": "Adjacent complexes, wrong-property switch",
      "user_id": "demo-user-1",
      "vehicle_id": "veh_demo_1",
      "property_id": "utd-001",
      "arrival": {
        "lat": 32.99505,
        "lng": -96.74775
      },
      "alternative_property_id": "utd-002",
      "expect": "draft at utd-001 with utd-002 in alternatives"
    },
    {
      "id": 6,
