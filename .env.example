# Copy to .env and fill in. Never commit .env. Names come from API_CONTRACT.md section 1.
API_BASE_URL=
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./parkour.db
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VISION_MODEL=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=
# Photon sidecar: where it forwards incoming replies, and whether it listens (stream) or not (off). No public URL needed.
BACKEND_URL=http://localhost:8000
PHOTON_INBOUND=stream
MESSENGER_URL=http://localhost:8790
INTERNAL_API_KEY=
MOCK_PORTAL_URL=http://localhost:8001
# SpacetimeDB holds accounts, cars, saved places, history and registrations. Default is the local server.
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=parkour
# Token of the identity that published the module: `spacetime login show --token`. Keep it secret.
SPACETIMEDB_TOKEN=
# true = every request needs a signed-in session (Authorization: Bearer). false still allows anonymous X-User-Id devices.
REQUIRE_AUTH=false
DEMO_MODE=false
# Optional demo knob (contract section 1): extra query params appended to the portal URL, e.g. captcha=on
DEMO_PORTAL_PARAMS=
# Demo phones (resolved by data/demo.json phone_env_var names)
DEMO_USER_1_PHONE=
DEMO_USER_2_PHONE=
