# Copy to deploy/.env.deploy on the server and fill in. Never commit it.

# --- public address ---
DOMAIN=parkour.example.com
PUBLIC_BASE_URL=https://parkour.example.com/api

# --- accounts: every request must be signed in ---
REQUIRE_AUTH=true

# --- SpacetimeDB (the container is reached by name; see deploy/README.md for the token) ---
SPACETIMEDB_DATABASE=parkour
SPACETIMEDB_TOKEN=

# --- shared secret between the API and the Photon sidecar: openssl rand -hex 24 ---
INTERNAL_API_KEY=

# --- AI ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VISION_MODEL=
DEMO_MODE=false

# --- how many browser runs at once. 1 for a 2 GB server, 2 for 4 GB or more ---
MAX_BROWSER_RUNS=1

# --- Photon ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=
PHOTON_INBOUND=stream
