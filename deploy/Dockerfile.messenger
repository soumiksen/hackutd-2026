# Photon sidecar: builds the TypeScript, then runs it with production dependencies only.
FROM node:22-slim AS build
WORKDIR /app
COPY messenger/package.json messenger/package-lock.json ./
RUN npm ci
COPY messenger/tsconfig.json ./
COPY messenger/src ./src
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY messenger/package.json messenger/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:8790/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
